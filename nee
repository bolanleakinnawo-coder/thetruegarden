
/* =========================
FAQ
========================= */

.faq {
padding: 120px 0 125px;
background: var(--white);
}

.faq-container {
width: min(92%, 900px);
margin: 0 auto;
}

.faq-header {
max-width: 650px;
margin-bottom: 50px;
}

.faq-header > span {
display: inline-block;
margin-bottom: 18px;
color: var(--gold);
font-size: 11px;
font-weight: 700;
letter-spacing: 2px;
}

.faq-header h2 {
color: var(--blue-dark);
font-size: clamp(45px, 5vw, 64px);
line-height: 1;
letter-spacing: -2.8px;
font-weight: 650;
}

.faq-header h2 span {
color: var(--gold);
font-family: "Cormorant Garamond", serif;
font-style: italic;
font-weight: 500;
}

.faq-header p {
max-width: 560px;
margin-top: 20px;
color: #687386;
font-size: 15px;
line-height: 1.8;
}

.faq-list {
border-top: 1px solid rgba(11, 58, 130, 0.12);
}

.faq-item {
border-bottom: 1px solid rgba(11, 58, 130, 0.12);
}

.faq-question {
width: 100%;
min-height: 82px;
padding: 0;
display: flex;
align-items: center;
justify-content: space-between;
gap: 25px;
border: none;
background: transparent;
color: var(--blue-dark);
font-family: "Poppins", sans-serif;
font-size: 16px;
font-weight: 600;
text-align: left;
cursor: pointer;
}

.faq-question strong {
width: 32px;
height: 32px;
flex-shrink: 0;
display: grid;
place-items: center;
border: 1px solid rgba(199, 164, 91, 0.45);
border-radius: 50%;
color: var(--gold);
font-size: 21px;
font-weight: 400;
line-height: 1;
transition:
transform 0.25s ease,
background 0.25s ease,
color 0.25s ease;
}

.faq-answer {
display: grid;
grid-template-rows: 0fr;
transition: grid-template-rows 0.3s ease;
}

.faq-answer p {
min-height: 0;
overflow: hidden;
color: #687386;
font-size: 14px;
line-height: 1.85;
max-width: 760px;
}

.faq-item.active .faq-answer {
grid-template-rows: 1fr;
}

.faq-item.active .faq-answer p {
padding-bottom: 25px;
}

.faq-item.active .faq-question strong {
background: var(--gold);
color: var(--blue-dark);
transform: rotate(180deg);
}

/* =========================
FINAL CTA
========================= */

.final-cta {
position: relative;
min-height: 650px;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
background: var(--blue-dark);
}

.final-cta-background {
position: absolute;
inset: 0;
}

.final-cta-background img {
width: 100%;
height: 100%;
object-fit: cover;
object-position: center;
filter: saturate(0.65);
transform: scale(1.04);
}

.final-cta-overlay {
position: absolute;
inset: 0;
background:
linear-gradient(
180deg,
rgba(8, 43, 97, 0.83),
rgba(8, 43, 97, 0.9)
);
}

.final-cta-container {
position: relative;
z-index: 2;
width: min(90%, 850px);
padding: 100px 0;
text-align: center;
}

.final-eyebrow {
display: inline-block;
margin-bottom: 22px;
color: var(--gold-light);
font-size: 11px;
font-weight: 700;
letter-spacing: 2px;
}

.final-cta h2 {
color: var(--white);
font-size: clamp(55px, 7vw, 88px);
line-height: 0.98;
letter-spacing: -4px;
font-weight: 650;
}

.final-cta h2 span {
color: var(--gold);
font-family: "Cormorant Garamond", serif;
font-style: italic;
font-weight: 500;
}

.final-cta-subtitle {
margin-top: 25px;
color: var(--gold-light);
font-family: "Cormorant Garamond", serif;
font-size: 34px;
font-style: italic;
}

.final-cta-text {
max-width: 560px;
margin: 20px auto 0;
color: rgba(255, 255, 255, 0.68);
font-size: 14px;
line-height: 1.8;
}

.final-cta-button {
min-height: 60px;
margin-top: 32px;
padding: 0 28px;
display: inline-flex;
align-items: center;
justify-content: center;
gap: 18px;
background: var(--gold);
color: var(--blue-dark);
border-radius: 6px;
font-size: 10px;
font-weight: 800;
letter-spacing: 0.9px;
transition:
transform 0.25s ease,
background 0.25s ease;
}

.final-cta-button span {
font-size: 20px;
transition: transform 0.25s ease;
}

.final-cta-button {
background: var(--gold-light);
transform: translateY(-3px);
}

.final-cta-button span {
transform: translateX(5px);
}

.final-cta-note {
margin-top: 35px;
display: flex;
align-items: center;
justify-content: center;
gap: 13px;
}

.final-cta-note span {
color: rgba(255, 255, 255, 0.45);
font-size: 8px;
font-weight: 700;
letter-spacing: 1.4px;
}

.final-cta-note div {
width: 25px;
height: 1px;
background: rgba(199, 164, 91, 0.5);
}

/* =========================
FOOTER
========================= */

.site-footer {
padding: 75px 0 25px;
background: #061f47;
}

.footer-container {
width: min(92%, 1180px);
margin: 0 auto;
}

.footer-main {
display: grid;
grid-template-columns: 1.5fr 1fr 0.7fr;
gap: 70px;
padding-bottom: 55px;
border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-logo {
display: inline-flex;
flex-direction: column;
text-decoration: none;
}

.footer-logo span {
color: var(--white);
font-size: 20px;
font-weight: 700;
letter-spacing: 0.8px;
}

.footer-logo em {
margin-top: 3px;
color: var(--gold);
font-family: "Cormorant Garamond", serif;
font-size: 20px;
font-style: italic;
font-weight: 600;
letter-spacing: 2.5px;
}

.footer-brand > p {
max-width: 310px;
margin-top: 20px;
color: rgba(255, 255, 255, 0.5);
font-size: 12px;
line-height: 1.8;
}

.footer-contact,
.footer-links {
display: flex;
flex-direction: column;
}

.footer-contact > span,
.footer-links > span {
margin-bottom: 18px;
color: var(--gold-light);
font-size: 9px;
font-weight: 700;
letter-spacing: 1.7px;
}

.footer-contact a,
.footer-contact p,
.footer-links a {
margin-bottom: 10px;
color: rgba(255, 255, 255, 0.62);
font-size: 11px;
line-height: 1.6;
transition: color 0.2s ease;
}

.footer-contact a,
.footer-links a {
color: var(--gold-light);
}

.footer-bottom {
padding-top: 25px;
display: flex;
align-items: center;
justify-content: space-between;
gap: 25px;
}

.footer-bottom > p {
color: rgba(255, 255, 255, 0.35);
font-size: 9px;
}

.footer-legal {
display: flex;
gap: 20px;
}

.footer-legal a {
color: rgba(255, 255, 255, 0.4);
font-size: 9px;
}

.footer-cta {
min-height: 43px;
padding: 0 17px;
display: inline-flex;
align-items: center;
gap: 10px;
background: var(--gold);
color: var(--blue-dark);
border-radius: 5px;
font-size: 8px;
font-weight: 800;
letter-spacing: 0.6px;
}

.footer-cta span {
font-size: 15px;
}

